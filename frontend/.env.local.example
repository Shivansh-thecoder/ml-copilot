# Copy this file to frontend/.env.local and adjust if your backend runs
# somewhere other than the default `uvicorn app.main:app` dev address.
# frontend/.env.local is git-ignored -- see frontend/.gitignore.
#
# Must be prefixed NEXT_PUBLIC_ -- that's what makes Next.js expose an
# env var to browser-side code (services/api.ts reads this one); a
# variable without that prefix would only be visible to server-side code,
# not the fetch() calls this app actually makes.
NEXT_PUBLIC_API_URL=http://localhost:8000
